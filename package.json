{
  "name": "ai-referee",
  "version": "0.1.0",
  "description": "Local, model-agnostic merge gate: runs your tests, sends the diff to any agent CLI or OpenAI-compatible API, and blocks the merge on REJECT. No referee, no merge.",
  "license": "MIT",
  "author": "ZoriaSoft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZoriaSoft/ai-referee.git"
  },
  "keywords": [
    "ai",
    "code-review",
    "llm",
    "merge-gate",
    "pull-request",
    "pre-push",
    "self-hosted"
  ],
  "type": "module",
  "bin": {
    "ai-referee": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "README.tr.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/ZoriaSoft/ai-referee#readme",
  "bugs": {
    "url": "https://github.com/ZoriaSoft/ai-referee/issues"
  }
}
